PORT=8080
PUBLIC_BASE_URL=https://tu-dominio.com
CORS_ORIGIN=
GRAPH_API_VERSION=v20.0
WHATSAPP_VERIFY_TOKEN=cambia-este-token
WHATSAPP_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=1234567890
# Obligatorio para que /webhooks/whatsapp acepte mensajes reales: sin esto, el
# servidor rechaza todo el trafico entrante del webhook por seguridad.
META_APP_SECRET=
SESSION_DAYS=7
SENDGRID_API_KEY=SG...
EMAIL_FROM=seguridad@tuempresa.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM=+525512345678
ANTHROPIC_API_KEY=
JOULE_MODEL=claude-sonnet-5
# RAG personal por WhatsApp (documentos/notas + memoria de conversacion), 100% local via Ollama.
# Requiere tener Ollama corriendo (https://ollama.com) y los modelos descargados:
#   ollama pull nomic-embed-text
#   ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
